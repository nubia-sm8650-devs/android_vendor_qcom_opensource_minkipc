cc_library_headers {
    name: "libminkadaptor_headers",
    vendor: true,
    export_include_dirs: ["libminkadaptor/include"],
}

cc_library_static {
    name: "libminkadaptor",
    vendor: true,
    srcs: [
        "libminkadaptor/src/mink_adaptor.c",
        "libminkadaptor/src/supplicant.c",
    ],
    arch: {
        arm: {
            srcs: ["libminkadaptor/src/syscall32.S"],
        },
        arm64: {
            srcs: ["libminkadaptor/src/syscall.S"],
        },
    },
    local_include_dirs: ["libminkadaptor/src"],
    header_libs: ["libminkadaptor_headers"],
    export_header_lib_headers: ["libminkadaptor_headers"],
    static_libs: ["libqcomtee"],
    export_static_lib_headers: ["libqcomtee"],
}
